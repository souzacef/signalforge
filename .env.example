POSTGRES_DB=signalforge
POSTGRES_USER=signalforge
POSTGRES_PASSWORD=signalforge-local
POSTGRES_PORT=5432
BACKEND_PORT=8000
DISPATCHER_METRICS_PORT=9101
CONSUMER_METRICS_PORT=9102
ENRICHMENT_METRICS_PORT=9103

# Local Compose broker defaults; replace the password for any shared environment.
RABBITMQ_DEFAULT_USER=signalforge
RABBITMQ_DEFAULT_PASS=signalforge-local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

SIGNALFORGE_APP_NAME=SignalForge
SIGNALFORGE_APP_ENVIRONMENT=development
SIGNALFORGE_DATABASE_URL=postgresql+asyncpg://signalforge:signalforge-local@localhost:5432/signalforge
# Generate locally with: openssl rand -hex 32
SIGNALFORGE_JWT_SECRET=
SIGNALFORGE_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Tracing is opt-in. The Compose endpoint need not exist while tracing is disabled.
SIGNALFORGE_TRACING_ENABLED=false
SIGNALFORGE_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
SIGNALFORGE_TRACING_SAMPLE_RATIO=1.0

# Optional local observability profile. Grafana credentials are development-only.
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=signalforge-local

# Required when running the dispatcher or consumer directly on the host. Compose
# builds the workers' internal URL from the local broker values above.
SIGNALFORGE_RABBITMQ_URL=
SIGNALFORGE_DISPATCHER_BATCH_SIZE=100
SIGNALFORGE_DISPATCHER_CLAIM_LEASE_SECONDS=30
SIGNALFORGE_DISPATCHER_PUBLISH_TIMEOUT_SECONDS=10
SIGNALFORGE_DISPATCHER_SETTLEMENT_BUDGET_SECONDS=5
SIGNALFORGE_DISPATCHER_IDLE_POLL_INTERVAL_SECONDS=1
SIGNALFORGE_DISPATCHER_RECONNECT_BASE_SECONDS=1
SIGNALFORGE_DISPATCHER_RECONNECT_MAX_SECONDS=30
SIGNALFORGE_DISPATCHER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

SIGNALFORGE_CONSUMER_PREFETCH_COUNT=1
SIGNALFORGE_CONSUMER_RECONNECT_BASE_SECONDS=1
SIGNALFORGE_CONSUMER_RECONNECT_MAX_SECONDS=30
SIGNALFORGE_CONSUMER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# Required only by the opt-in enrichment worker / Compose ai profile.
SIGNALFORGE_GEMINI_API_KEY=
SIGNALFORGE_GEMINI_MODEL=gemini-3.8-flash
SIGNALFORGE_ENRICHMENT_WORKER_PREFETCH_COUNT=1
SIGNALFORGE_ENRICHMENT_WORKER_RECONNECT_BASE_SECONDS=1
SIGNALFORGE_ENRICHMENT_WORKER_RECONNECT_MAX_SECONDS=30
SIGNALFORGE_ENRICHMENT_WORKER_PROCESSING_RETRY_BASE_SECONDS=1
SIGNALFORGE_ENRICHMENT_WORKER_PROCESSING_RETRY_MAX_SECONDS=30
SIGNALFORGE_ENRICHMENT_WORKER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# Required only by the opt-in remediation worker / Compose remediation profile.
# Example only: replace this trusted endpoint allowlist for your environment.
SIGNALFORGE_REMEDIATION_RESTART_ENDPOINTS={"checkout-api":"http://control-plane.internal/restart/checkout"}
SIGNALFORGE_REMEDIATION_REQUEST_TIMEOUT_SECONDS=5
SIGNALFORGE_REMEDIATION_ATTEMPT_LEASE_SECONDS=45
SIGNALFORGE_REMEDIATION_WORKER_RECONNECT_BASE_SECONDS=1
SIGNALFORGE_REMEDIATION_WORKER_RECONNECT_MAX_SECONDS=30
SIGNALFORGE_REMEDIATION_WORKER_PROCESSING_RETRY_BASE_SECONDS=1
SIGNALFORGE_REMEDIATION_WORKER_PROCESSING_RETRY_MAX_SECONDS=30
SIGNALFORGE_REMEDIATION_WORKER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=40
