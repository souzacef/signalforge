    {
      "id": 21,
      "type": "table",
      "title": "Recent remediation traces",
      "description": "Requires tracing enabled and the remediation profile for actual worker spans. PROCESS spans continue RabbitMQ context; an actual allowlisted actuator call appears as a CLIENT child span. Rejected, duplicate, stale, or otherwise non-actuating deliveries may have no actuator span.",
      "gridPos": {
        "x": 0,
        "y": 74,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"signalforge-remediation-worker\" }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
